

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git Add, Commit, and Push",
      "type": "shell",
      "command": "git add . && git commit -m \"${input:commitMessage}\" && git push",
      "options": {
        "shell": {
          "executable": "cmd.exe"
        }
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "description": "Enter your commit message:",
      "type": "promptString",
      "default": "Update from VS Code"
    }
  ]
}
